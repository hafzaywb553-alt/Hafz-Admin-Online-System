rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function currentUserExists() {
      return signedIn() && exists(adminPath());
    }

    function currentUserDoc() {
      return get(adminPath());
    }

    function currentUserActive() {
      return currentUserExists() && currentUserDoc().data.active == true;
    }

    function currentUserRole() {
      return currentUserDoc().data.role;
    }

    function isSuperAdmin() {
      return currentUserActive() && currentUserRole() == "superadmin";
    }

    function isAdmin() {
      return currentUserActive() &&
        (currentUserRole() == "superadmin" || currentUserRole() == "admin");
    }

    function isMember() {
      return currentUserActive() &&
        (currentUserRole() == "superadmin" ||
         currentUserRole() == "admin" ||
         currentUserRole() == "user");
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /presence/{uid} {
      allow read: if isMember();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /records/{recordId} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    match /activity/{docId} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}