rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        // =========================================================
        // AUTHENTICATION
        // =========================================================

        function signedIn() {

            return request.auth != null;

        }


        function adminPath(uid) {

            return /databases/$(database)/documents/admins/$(uid);

        }


        function adminExists(uid) {

            return exists(
                adminPath(uid)
            );

        }


        function adminData(uid) {

            return get(
                adminPath(uid)
            ).data;

        }


        function hasValidAdminProfile() {

            return signedIn()

                && adminExists(
                    request.auth.uid
                )

                && adminData(
                    request.auth.uid
                ).uid
                    == request.auth.uid

                && adminData(
                    request.auth.uid
                ).active
                    == true

                && (

                    adminData(
                        request.auth.uid
                    ).role
                        == "superadmin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "admin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "user"

                );

        }


        function isSuperAdmin() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "superadmin";

        }


        function isAdmin() {

            return hasValidAdminProfile()

                && (

                    adminData(
                        request.auth.uid
                    ).role
                        == "superadmin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "admin"

                );

        }


        function isUser() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "user";

        }


        function isMember() {

            return hasValidAdminProfile();

        }


        // =========================================================
        // ADMINS
        // =========================================================

        match /admins/{uid} {

            allow get: if signedIn()

                && (

                    request.auth.uid
                        == uid

                    ||

                    isSuperAdmin()

                );


            allow list: if isSuperAdmin();


            allow create:
                if isSuperAdmin();


            allow update:
                if isSuperAdmin();


            allow delete:
                if isSuperAdmin();

        }


        // =========================================================
        // RECORDS
        // =========================================================

        match /records/{recordId} {


            // -----------------------------------------------------
            // GET
            // -----------------------------------------------------
            //
            // Super Admin:
            // ټول Recordونه
            //
            // Admin/User:
            // یوازې هغه Record چې hiddenFromAdmins != true
            //
            // -----------------------------------------------------

            allow get: if isSuperAdmin();


            allow get: if isMember()

                && (

                    !(
                        resource.data
                            .visibility
                            .hiddenFromAdmins
                            == true
                    )

                );


            // -----------------------------------------------------
            // LIST
            // -----------------------------------------------------
            //
            // Super Admin:
            // ټول Recordونه.
            //
            // Admin/User:
            // Query باید hiddenFromAdmins == false ولري.
            //
            // -----------------------------------------------------

            allow list:
                if isSuperAdmin();


            allow list:
                if isMember()

                && resource.data
                    .visibility
                    .hiddenFromAdmins
                    == false;


            // -----------------------------------------------------
            // CREATE
            // -----------------------------------------------------

            allow create:
                if isAdmin();


            // -----------------------------------------------------
            // UPDATE
            // -----------------------------------------------------
            //
            // Super Admin:
            // بشپړ.
            //
            // Admin:
            // یوازې ښکاره او خلاص Record.
            //
            // -----------------------------------------------------

            allow update:
                if isSuperAdmin();


            allow update:
                if isAdmin()

                && resource.data
                    .visibility
                    .hiddenFromAdmins
                    == false

                && resource.data
                    .editable
                    != false

                && request.resource.data
                    .visibility
                    .hiddenFromAdmins
                    == false

                && request.resource.data
                    .editable
                    != false;


            // -----------------------------------------------------
            // DELETE
            // -----------------------------------------------------

            allow delete:
                if isSuperAdmin();

        }


        // =========================================================
        // UNIQUE NUMBERS
        // =========================================================

        match /uniqueNumbers/{uniqueId} {

            allow read:
                if isAdmin();


            allow create:
                if isAdmin()

                && request.resource.data.recordId
                    is string

                && request.resource.data.type
                    is string

                && request.resource.data.number
                    is string

                && request.resource.data.createdByName
                    is string

                && request.resource.data.createdByEmail
                    is string;


            allow update:
                if isAdmin()

                && request.resource.data.recordId
                    is string

                && request.resource.data.type
                    is string

                && request.resource.data.number
                    is string

                && request.resource.data.createdByName
                    is string

                && request.resource.data.createdByEmail
                    is string;


            allow delete:
                if isAdmin();

        }


        // =========================================================
        // SYSTEM SETTINGS
        // =========================================================
        //
        // مهم:
        // Field Config یوازې Super Admin بدلولی شي.
        //
        // =========================================================

        match /settings/{settingId} {

            allow read:
                if isMember();


            allow create:
                if isSuperAdmin();


            allow update:
                if isSuperAdmin();


            allow delete:
                if isSuperAdmin();

        }


        // =========================================================
        // FORMIC SETTINGS
        // =========================================================

        match /formic_settings/{settingId} {

            allow read:
                if isMember();


            allow create:
                if isSuperAdmin();


            allow update:
                if isSuperAdmin();


            allow delete:
                if isSuperAdmin();

        }


        // =========================================================
        // PRESENCE
        // =========================================================

        match /presence/{uid} {

            allow read:
                if isMember();


            allow create:
                if isMember()

                && request.auth.uid
                    == uid;


            allow update:
                if isMember()

                && request.auth.uid
                    == uid;


            allow delete:
                if isMember()

                && request.auth.uid
                    == uid;

        }


        // =========================================================
        // AUDIT
        // =========================================================

        match /audit/{auditId} {

            allow create:
                if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email;


            allow read:
                if isSuperAdmin();


            allow update:
                if false;


            allow delete:
                if false;

        }


        // =========================================================
        // DASHBOARD COMMENTS
        // =========================================================

        match /dashboard_comments/{commentId} {

            allow read:
                if isMember();


            allow create:
                if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email

                && request.resource.data.text
                    is string

                && request.resource.data.text.size()
                    > 0

                && request.resource.data.text.size()
                    <= 500

                && request.resource.data.displayName
                    is string

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            allow update:
                if isMember()

                && request.resource.data.uid
                    == resource.data.uid

                && request.resource.data.email
                    == resource.data.email

                && request.resource.data.displayName
                    == resource.data.displayName

                && request.resource.data.text
                    == resource.data.text

                && request.resource.data.createdAt
                    == resource.data.createdAt

                && request.resource.data.diff(
                    resource.data
                ).affectedKeys().hasOnly(
                    [
                        "likes",
                        "hearts"
                    ]
                )

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            allow delete:
                if isSuperAdmin()

                || (

                    isMember()

                    && resource.data.uid
                        == request.auth.uid

                );

        }


        // =========================================================
        // DAILY ISLAMIC CONTENT
        // =========================================================

        match /dashboard_daily_content/{contentId} {

            allow read:
                if isMember();


            allow create:
                if isSuperAdmin()

                && request.resource.data.zikr
                    is string

                && request.resource.data.zikr.size()
                    > 0

                && request.resource.data.zikr.size()
                    <= 1000

                && request.resource.data.comfort
                    is string

                && request.resource.data.comfort.size()
                    > 0

                && request.resource.data.comfort.size()
                    <= 1000

                && request.resource.data.poem
                    is string

                && request.resource.data.poem.size()
                    > 0

                && request.resource.data.poem.size()
                    <= 1000

                && request.resource.data.updatedBy
                    == request.auth.uid

                && request.resource.data.updatedByEmail
                    == request.auth.token.email;


            allow update:
                if isSuperAdmin()

                && request.resource.data.zikr
                    is string

                && request.resource.data.zikr.size()
                    > 0

                && request.resource.data.zikr.size()
                    <= 1000

                && request.resource.data.comfort
                    is string

                && request.resource.data.comfort.size()
                    > 0

                && request.resource.data.comfort.size()
                    <= 1000

                && request.resource.data.poem
                    is string

                && request.resource.data.poem.size()
                    > 0

                && request.resource.data.poem.size()
                    <= 1000

                && request.resource.data.updatedBy
                    == request.auth.uid

                && request.resource.data.updatedByEmail
                    == request.auth.token.email;


            allow delete:
                if false;

        }


        // =========================================================
        // DEFAULT DENY
        // =========================================================

        match /{document=**} {

            allow read, write:
                if false;

        }

    }

}