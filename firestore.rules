rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {

// =========================================================
// د افغانستان اسلامی امارت د کره کمیسیون د فورمو د ثبت او
// مدیریت ډیټابیس
//
// Roles:
// superadmin = بشپړ صلاحیت
// admin = ثبت، بدلون او اړوند مدیریت
// user = یوازې لټون / Read
// =========================================================


// =========================================================
// Authentication Helpers
// =========================================================

function signedIn() {
return request.auth != null;
}


function adminPath(uid) {
return /databases/$(database)/documents/admins/$(uid);
}


function adminExists(uid) {
return exists(adminPath(uid));
}


function adminData(uid) {
return get(adminPath(uid)).data;
}


// =========================================================
// Current User Profile
// =========================================================

function hasValidAdminProfile() {
return signedIn()
&& adminExists(request.auth.uid)
&& adminData(request.auth.uid).uid == request.auth.uid
&& adminData(request.auth.uid).active == true
&& (
adminData(request.auth.uid).role == "superadmin" ||
adminData(request.auth.uid).role == "admin" ||
adminData(request.auth.uid).role == "user"
);
}


function isSuperAdmin() {
return hasValidAdminProfile()
&& adminData(request.auth.uid).role == "superadmin";
}


function isAdmin() {
return hasValidAdminProfile()
&& (
adminData(request.auth.uid).role == "superadmin" ||
adminData(request.auth.uid).role == "admin"
);
}


function isUser() {
return hasValidAdminProfile()
&& adminData(request.auth.uid).role == "user";
}


function isMember() {
return hasValidAdminProfile();
}


// =========================================================
// ADMINS
// =========================================================
//
// User:
// خپل Profile یوازې get کولی شي.
//
// Admin:
// د نورو Admin Profiles مدیریت نه شي کولی.
//
// Superadmin:
// بشپړ Admin management.
//
// =========================================================

match /admins/{uid} {

// خپل Profile لوستل
// Superadmin کولی شي هر Profile ولولي.
allow get: if signedIn()
&& (
request.auth.uid == uid ||
isSuperAdmin()
);


// یوازې Superadmin ټول Admin list کولی شي.
allow list: if isSuperAdmin();


// یوازې Superadmin نوی Admin جوړولی شي.
allow create: if isSuperAdmin();


// یوازې Superadmin Admin Profile بدلولی شي.
allow update: if isSuperAdmin();


// یوازې Superadmin Admin حذف کولی شي.
allow delete: if isSuperAdmin();
}


// =========================================================
// RECORDS
// =========================================================
//
// user:
// یوازې Read/Search
// Create = NO
// Update = NO
// Delete = NO
//
// admin:
// Read
// Create
// Update
// Delete = NO
//
// superadmin:
// Read
// Create
// Update
// Delete
//
// =========================================================

match /records/{recordId} {

// ټول فعال authenticated roles کولی شي
// records ولولي او Search وکړي.
allow read: if isMember();


// یوازې Admin او Superadmin ثبت کولی شي.
allow create: if isAdmin();


// یوازې Admin او Superadmin بدلون کولی شي.
allow update: if isAdmin();


// یوازې Superadmin حذف کولی شي.
allow delete: if isSuperAdmin();
}


// =========================================================
// SETTINGS
// =========================================================
//
// ټول فعال users settings لوستلی شي.
// یوازې Admin/Superadmin settings بدلولی شي.
//
// =========================================================

match /settings/{settingId} {

allow read: if isMember();

allow create: if isAdmin();

allow update: if isAdmin();

allow delete: if isSuperAdmin();
}


// =========================================================
// PRESENCE
// =========================================================
//
// Online users:
// هر فعال Member کولی شي Presence ولولي.
//
// هر user یوازې خپل Presence جوړولی/بدلولی/حذفولی شي.
//
// =========================================================

match /presence/{uid} {

allow read: if isMember();

allow create: if isMember()
&& request.auth.uid == uid;

allow update: if isMember()
&& request.auth.uid == uid;

allow delete: if isMember()
&& request.auth.uid == uid;
}


// =========================================================
// AUDIT
// =========================================================
//
// audit.js لاندې fields جوړوي:
//
// action
// details
// uid
// email
// time
//
// هر authenticated فعال Member کولی شي خپل Audit event
// ثبت کړي.
//
// Audit records نه update کېږي او نه delete کېږي.
//
// یوازې Superadmin یې لوستلی شي.
//
// =========================================================

match /audit/{auditId} {

allow create: if isMember()
&& request.resource.data.uid == request.auth.uid
&& request.resource.data.email == request.auth.token.email;


allow read: if isSuperAdmin();


allow update: if false;

allow delete: if false;
}


// =========================================================
// DEFAULT DENY
// =========================================================
//
// هر هغه Collection/Document چې پورته تعریف شوی نه وي،
// په اتومات ډول بند دی.
//
// =========================================================

match /{document=**} {
allow read, write: if false;
}
}
}