rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        // =========================================================
        // د افغانستان اسلامي امارت د کره کمیسیون
        // د فورمو د ثبت او مدیریت ډیټابیس
        //
        // Roles:
        // superadmin = بشپړ صلاحیت
        // admin      = ثبت، بدلون او اړوند مدیریت
        // user       = Read / Search
        // =========================================================


        // =========================================================
        // Authentication Helpers
        // =========================================================

        function signedIn() {

            return request.auth != null;

        }


        function adminPath(uid) {

            return /databases/$(database)/documents/admins/$(uid);

        }


        function adminExists(uid) {

            return exists(
                adminPath(uid)
            );

        }


        function adminData(uid) {

            return get(
                adminPath(uid)
            ).data;

        }


        // =========================================================
        // Current User Profile
        // =========================================================

        function hasValidAdminProfile() {

            return signedIn()

                && adminExists(
                    request.auth.uid
                )

                && adminData(
                    request.auth.uid
                ).uid
                    == request.auth.uid

                && adminData(
                    request.auth.uid
                ).active
                    == true

                && (

                    adminData(
                        request.auth.uid
                    ).role
                        == "superadmin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "admin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "user"

                );

        }


        function isSuperAdmin() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "superadmin";

        }


        function isAdmin() {

            return hasValidAdminProfile()

                && (

                    adminData(
                        request.auth.uid
                    ).role
                        == "superadmin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "admin"

                );

        }


        function isUser() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "user";

        }


        function isMember() {

            return hasValidAdminProfile();

        }


        // =========================================================
        // ADMINS
        // =========================================================

        match /admins/{uid} {

            allow get: if signedIn()

                && (

                    request.auth.uid == uid

                    ||

                    isSuperAdmin()

                );


            allow list: if isSuperAdmin();


            allow create: if isSuperAdmin();


            allow update: if isSuperAdmin();


            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // RECORDS
        // =========================================================

        match /records/{recordId} {

            allow read: if isMember();


            allow create: if isAdmin();


            allow update: if isAdmin();


            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // UNIQUE NUMBERS
        // =========================================================

        match /uniqueNumbers/{uniqueId} {

            allow read: if isAdmin();


            allow create: if isAdmin()

                && request.resource.data.recordId
                    is string

                && request.resource.data.type
                    is string

                && request.resource.data.number
                    is string

                && request.resource.data.createdByName
                    is string

                && request.resource.data.createdByEmail
                    is string;


            allow update: if isAdmin()

                && request.resource.data.recordId
                    is string

                && request.resource.data.type
                    is string

                && request.resource.data.number
                    is string

                && request.resource.data.createdByName
                    is string

                && request.resource.data.createdByEmail
                    is string;


            allow delete: if isAdmin();

        }


        // =========================================================
        // SETTINGS
        // =========================================================

        match /settings/{settingId} {

            allow read: if isMember();


            allow create: if isAdmin();


            allow update: if isAdmin();


            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // FORMIC SETTINGS
        // =========================================================
        //
        // Collection:
        // formic_settings
        //
        // Document:
        // اصلي
        //
        // Read:
        // ټول فعال غړي
        //
        // Create / Update / Delete:
        // یوازې Superadmin
        //
        // مهم:
        // د Formic د داخلي structure پر فیلډونو
        // هېڅ اضافي validation شرط نه لګوو.
        //
        // =========================================================

        match /formic_settings/{settingId} {

            allow read: if isMember();


            allow create: if isSuperAdmin();


            allow update: if isSuperAdmin();


            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // PRESENCE
        // =========================================================

        match /presence/{uid} {

            allow read: if isMember();


            allow create: if isMember()
                && request.auth.uid == uid;


            allow update: if isMember()
                && request.auth.uid == uid;


            allow delete: if isMember()
                && request.auth.uid == uid;

        }


        // =========================================================
        // AUDIT
        // =========================================================

        match /audit/{auditId} {

            allow create: if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email;


            allow read: if isSuperAdmin();


            allow update: if false;


            allow delete: if false;

        }


        // =========================================================
        // DASHBOARD COMMENTS
        // =========================================================

        match /dashboard_comments/{commentId} {

            allow read: if isMember();


            allow create: if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email

                && request.resource.data.text
                    is string

                && request.resource.data.text.size()
                    > 0

                && request.resource.data.text.size()
                    <= 500

                && request.resource.data.displayName
                    is string

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            allow update: if isMember()

                && request.resource.data.uid
                    == resource.data.uid

                && request.resource.data.email
                    == resource.data.email

                && request.resource.data.displayName
                    == resource.data.displayName

                && request.resource.data.text
                    == resource.data.text

                && request.resource.data.createdAt
                    == resource.data.createdAt

                && request.resource.data.diff(
                    resource.data
                ).affectedKeys().hasOnly(
                    [
                        "likes",
                        "hearts"
                    ]
                )

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            allow delete: if isSuperAdmin()

                || (

                    isMember()

                    && resource.data.uid
                        == request.auth.uid

                );

        }


        // =========================================================
        // DAILY ISLAMIC CONTENT
        // =========================================================

        match /dashboard_daily_content/{contentId} {

            allow read: if isMember();


            allow create: if isSuperAdmin()

                && request.resource.data.zikr
                    is string

                && request.resource.data.zikr.size()
                    > 0

                && request.resource.data.zikr.size()
                    <= 1000

                && request.resource.data.comfort
                    is string

                && request.resource.data.comfort.size()
                    > 0

                && request.resource.data.comfort.size()
                    <= 1000

                && request.resource.data.poem
                    is string

                && request.resource.data.poem.size()
                    > 0

                && request.resource.data.poem.size()
                    <= 1000

                && request.resource.data.updatedBy
                    == request.auth.uid

                && request.resource.data.updatedByEmail
                    == request.auth.token.email;


            allow update: if isSuperAdmin()

                && request.resource.data.zikr
                    is string

                && request.resource.data.zikr.size()
                    > 0

                && request.resource.data.zikr.size()
                    <= 1000

                && request.resource.data.comfort
                    is string

                && request.resource.data.comfort.size()
                    > 0

                && request.resource.data.comfort.size()
                    <= 1000

                && request.resource.data.poem
                    is string

                && request.resource.data.poem.size()
                    > 0

                && request.resource.data.poem.size()
                    <= 1000

                && request.resource.data.updatedBy
                    == request.auth.uid

                && request.resource.data.updatedByEmail
                    == request.auth.token.email;


            allow delete: if false;

        }


        // =========================================================
        // DEFAULT DENY
        // =========================================================

        match /{document=**} {

            allow read, write: if false;

        }

    }

}