rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        // =========================================================
        // د افغانستان اسلامي امارت د کره کمیسیون
        // د فورمو د ثبت او مدیریت ډیټابیس
        //
        // Roles:
        // superadmin = بشپړ صلاحیت
        // admin      = ثبت، بدلون او اړوند مدیریت
        // user       = Read / Search
        // =========================================================


        // =========================================================
        // Authentication Helpers
        // =========================================================

        function signedIn() {
            return request.auth != null;
        }


        function adminPath(uid) {
            return /databases/$(database)/documents/admins/$(uid);
        }


        function adminExists(uid) {
            return exists(adminPath(uid));
        }


        function adminData(uid) {
            return get(adminPath(uid)).data;
        }


        // =========================================================
        // Current User Profile
        // =========================================================

        function hasValidAdminProfile() {

            return signedIn()

                && adminExists(request.auth.uid)

                && adminData(request.auth.uid).uid
                    == request.auth.uid

                && adminData(request.auth.uid).active
                    == true

                && (
                    adminData(request.auth.uid).role
                        == "superadmin"

                    ||

                    adminData(request.auth.uid).role
                        == "admin"

                    ||

                    adminData(request.auth.uid).role
                        == "user"
                );
        }


        function isSuperAdmin() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "superadmin";
        }


        function isAdmin() {

            return hasValidAdminProfile()

                && (
                    adminData(
                        request.auth.uid
                    ).role
                        == "superadmin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "admin"
                );
        }


        function isUser() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "user";
        }


        function isMember() {

            return hasValidAdminProfile();
        }


        // =========================================================
        // ADMINS
        // =========================================================

        match /admins/{uid} {


            // خپل Profile لوستل
            // Superadmin کولی شي هر Profile ولولي
            allow get: if signedIn()
                && (
                    request.auth.uid == uid
                    ||
                    isSuperAdmin()
                );


            // یوازې Superadmin ټول Admin list کولی شي
            allow list: if isSuperAdmin();


            // یوازې Superadmin نوی Admin جوړولی شي
            allow create: if isSuperAdmin();


            // یوازې Superadmin Admin Profile بدلولی شي
            allow update: if isSuperAdmin();


            // یوازې Superadmin Admin حذف کولی شي
            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // RECORDS
        // =========================================================

        match /records/{recordId} {


            // ټول فعال roles کولی شي records ولولي
            allow read: if isMember();


            // یوازې Admin او Superadmin ثبت کولی شي
            allow create: if isAdmin();


            // یوازې Admin او Superadmin بدلون کولی شي
            allow update: if isAdmin();


            // یوازې Superadmin حذف کولی شي
            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // SETTINGS
        // =========================================================

        match /settings/{settingId} {


            // ټول فعال users settings لوستلی شي
            allow read: if isMember();


            // Admin / Superadmin
            allow create: if isAdmin();


            // Admin / Superadmin
            allow update: if isAdmin();


            // یوازې Superadmin
            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // PRESENCE
        // =========================================================

        match /presence/{uid} {


            // ټول فعال Members presence لوستلی شي
            allow read: if isMember();


            // هر user یوازې خپل presence جوړولی شي
            allow create: if isMember()
                && request.auth.uid == uid;


            // هر user یوازې خپل presence بدلولی شي
            allow update: if isMember()
                && request.auth.uid == uid;


            // هر user یوازې خپل presence حذفولی شي
            allow delete: if isMember()
                && request.auth.uid == uid;

        }


        // =========================================================
        // AUDIT
        // =========================================================

        match /audit/{auditId} {


            // هر فعال Member خپل audit event ثبتولی شي
            allow create: if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email;


            // یوازې Superadmin لوستلی شي
            allow read: if isSuperAdmin();


            // Audit نه update کېږي
            allow update: if false;


            // Audit نه delete کېږي
            allow delete: if false;

        }


        // =========================================================
        // DASHBOARD COMMENTS
        // =========================================================
        //
        // د Live Dashboard ټولنیز مرکز
        //
        // fields:
        // text
        // uid
        // displayName
        // email
        // createdAt
        // likes[]
        // hearts[]
        //
        // ټول فعال Members:
        // - Comment create
        // - Comment read
        // - Like
        // - Heart
        //
        // text / uid / author:
        // وروسته نه بدلېږي
        //
        // update یوازې:
        // likes / hearts
        // =========================================================

        match /dashboard_comments/{commentId} {


            // ټول فعال Members comments لوستلی شي
            allow read: if isMember();


            // نوی Comment
            allow create: if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email

                && request.resource.data.text
                    is string

                && request.resource.data.text.size()
                    > 0

                && request.resource.data.text.size()
                    <= 500

                && request.resource.data.displayName
                    is string

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            // -----------------------------------------------------
            // Like / Heart
            // -----------------------------------------------------
            //
            // User نشي کولی:
            // text
            // uid
            // email
            // displayName
            // createdAt
            //
            // بدل کړي.
            //
            // یوازې likes/hearts arrays بدلولی شي.
            // -----------------------------------------------------

            allow update: if isMember()

                && request.resource.data.uid
                    == resource.data.uid

                && request.resource.data.email
                    == resource.data.email

                && request.resource.data.displayName
                    == resource.data.displayName

                && request.resource.data.text
                    == resource.data.text

                && request.resource.data.createdAt
                    == resource.data.createdAt

                && request.resource.data.diff(
                    resource.data
                ).affectedKeys().hasOnly(
                    [
                        "likes",
                        "hearts"
                    ]
                )

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            // Comments حذفول
            allow delete: if false;

        }


        // =========================================================
        // DEFAULT DENY
        // =========================================================

        match /{document=**} {

            allow read, write: if false;

        }

    }

}
