rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        // =========================================================
        // د افغانستان اسلامي امارت د کره کمیسیون
        // د فورمو د ثبت او مدیریت ډیټابیس
        //
        // Roles:
        // superadmin = بشپړ صلاحیت
        // admin      = ثبت، بدلون او اړوند مدیریت
        // user       = Read / Search
        // =========================================================


        // =========================================================
        // Authentication Helpers
        // =========================================================

        function signedIn() {
            return request.auth != null;
        }


        function adminPath(uid) {
            return /databases/$(database)/documents/admins/$(uid);
        }


        function adminExists(uid) {
            return exists(adminPath(uid));
        }


        function adminData(uid) {
            return get(adminPath(uid)).data;
        }


        // =========================================================
        // Current User Profile
        // =========================================================

        function hasValidAdminProfile() {

            return signedIn()

                && adminExists(request.auth.uid)

                && adminData(request.auth.uid).uid
                    == request.auth.uid

                && adminData(request.auth.uid).active
                    == true

                && (
                    adminData(request.auth.uid).role
                        == "superadmin"

                    ||

                    adminData(request.auth.uid).role
                        == "admin"

                    ||

                    adminData(request.auth.uid).role
                        == "user"
                );
        }


        function isSuperAdmin() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "superadmin";
        }


        function isAdmin() {

            return hasValidAdminProfile()

                && (
                    adminData(
                        request.auth.uid
                    ).role
                        == "superadmin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "admin"
                );
        }


        function isUser() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "user";
        }


        function isMember() {

            return hasValidAdminProfile();
        }


        // =========================================================
        // ADMINS
        // =========================================================

        match /admins/{uid} {

            // خپل Profile لوستل
            // Superadmin کولی شي هر Profile ولولي
            allow get: if signedIn()
                && (
                    request.auth.uid == uid
                    ||
                    isSuperAdmin()
                );


            // یوازې Superadmin ټول Admin list کولی شي
            allow list: if isSuperAdmin();


            // یوازې Superadmin نوی Admin جوړولی شي
            allow create: if isSuperAdmin();


            // یوازې Superadmin Admin Profile بدلولی شي
            allow update: if isSuperAdmin();


            // یوازې Superadmin Admin حذف کولی شي
            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // RECORDS
        // =========================================================

        match /records/{recordId} {

            // ټول فعال roles کولی شي records ولولي
            allow read: if isMember();


            // Superadmin + Admin نوي کسان ثبتولی شي
            allow create: if isAdmin();


            // Superadmin + Admin ثبت شوي معلومات بدلولی شي
            allow update: if isAdmin();


            // یوازې Superadmin حذف کولی شي
            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // UNIQUE NUMBERS
        // =========================================================
        //
        // register.js د ثبت پر مهال دا Collection کاروي:
        //
        // - formNumber
        // - electronicTazkiraNumber
        // - paperTazkiraNumber
        //
        // Transaction:
        // - get
        // - create
        // - update
        // - delete
        //
        // ځکه نو د Admin او Superadmin لپاره بشپړ
        // transaction access ضروري دی.
        // =========================================================

        match /uniqueNumbers/{uniqueId} {

            // Superadmin + Admin د duplicate check
            // او transaction لپاره لوستلی شي
            allow read: if isAdmin();


            // Superadmin + Admin نوی unique number جوړولی شي
            allow create: if isAdmin()

                && request.resource.data.recordId
                    is string

                && request.resource.data.type
                    is string

                && request.resource.data.number
                    is string

                && request.resource.data.createdByName
                    is string

                && request.resource.data.createdByEmail
                    is string;


            // Superadmin + Admin موجود unique number بدلولی شي
            allow update: if isAdmin()

                && request.resource.data.recordId
                    is string

                && request.resource.data.type
                    is string

                && request.resource.data.number
                    is string

                && request.resource.data.createdByName
                    is string

                && request.resource.data.createdByEmail
                    is string;


            // Admin هم د edit/delete transaction لپاره
            // زاړه unique number حذفولی شي
            allow delete: if isAdmin();

        }


        // =========================================================
        // SETTINGS
        // =========================================================

        match /settings/{settingId} {

            // ټول فعال users settings لوستلی شي
            allow read: if isMember();


            // Admin / Superadmin
            allow create: if isAdmin();


            // Admin / Superadmin
            allow update: if isAdmin();


            // یوازې Superadmin
            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // FORMIC SETTINGS
        // =========================================================
        //
        // Collection:
        // formic_settings
        //
        // Document:
        // اصلي
        //
        // Read:
        // ټول فعال کاروونکي
        //
        // Create / Update / Delete:
        // یوازې Superadmin
        //
        // =========================================================

        match /formic_settings/{settingId} {

            // ټول فعال کاروونکي یې لوستلی شي
            allow read: if isMember();


            // نوی Formic سند
            // یوازې Superadmin
            allow create: if isSuperAdmin()

                && request.resource.data["شیتونه"]
                    is list

                && request.resource.data["بدلون_ورکوونکی"]
                    == request.auth.uid;


            // موجود Formic سند بدلول
            // یوازې Superadmin
            allow update: if isSuperAdmin()

                && request.resource.data["شیتونه"]
                    is list

                && request.resource.data["بدلون_ورکوونکی"]
                    == request.auth.uid;


            // حذف
            // یوازې Superadmin
            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // PRESENCE
        // =========================================================

        match /presence/{uid} {

            // ټول فعال Members presence لوستلی شي
            allow read: if isMember();


            // هر user یوازې خپل presence جوړولی شي
            allow create: if isMember()
                && request.auth.uid == uid;


            // هر user یوازې خپل presence بدلولی شي
            allow update: if isMember()
                && request.auth.uid == uid;


            // هر user یوازې خپل presence حذفولی شي
            allow delete: if isMember()
                && request.auth.uid == uid;

        }


        // =========================================================
        // AUDIT
        // =========================================================

        match /audit/{auditId} {

            // هر فعال Member خپل audit event ثبتولی شي
            allow create: if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email;


            // یوازې Superadmin لوستلی شي
            allow read: if isSuperAdmin();


            // Audit نه update کېږي
            allow update: if false;


            // Audit نه delete کېږي
            allow delete: if false;

        }


        // =========================================================
        // DASHBOARD COMMENTS
        // =========================================================

        match /dashboard_comments/{commentId} {

            // ټول فعال Members comments لوستلی شي
            allow read: if isMember();


            // نوی Comment
            allow create: if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email

                && request.resource.data.text
                    is string

                && request.resource.data.text.size()
                    > 0

                && request.resource.data.text.size()
                    <= 500

                && request.resource.data.displayName
                    is string

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            // Like / Heart
            allow update: if isMember()

                && request.resource.data.uid
                    == resource.data.uid

                && request.resource.data.email
                    == resource.data.email

                && request.resource.data.displayName
                    == resource.data.displayName

                && request.resource.data.text
                    == resource.data.text

                && request.resource.data.createdAt
                    == resource.data.createdAt

                && request.resource.data.diff(
                    resource.data
                ).affectedKeys().hasOnly(
                    [
                        "likes",
                        "hearts"
                    ]
                )

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            // Delete:
            // Superadmin هر comment
            // User خپل comment
            allow delete: if isSuperAdmin()

                || (
                    isMember()

                    && resource.data.uid
                        == request.auth.uid
                );

        }


        // =========================================================
        // DAILY ISLAMIC CONTENT
        // =========================================================

        match /dashboard_daily_content/{contentId} {

            // ټول فعال کارکوونکي یې لوستلی شي
            allow read: if isMember();


            // یوازې Superadmin نوی محتوا جوړولی شي
            allow create: if isSuperAdmin()

                && request.resource.data.zikr
                    is string

                && request.resource.data.zikr.size()
                    > 0

                && request.resource.data.zikr.size()
                    <= 1000

                && request.resource.data.comfort
                    is string

                && request.resource.data.comfort.size()
                    > 0

                && request.resource.data.comfort.size()
                    <= 1000

                && request.resource.data.poem
                    is string

                && request.resource.data.poem.size()
                    > 0

                && request.resource.data.poem.size()
                    <= 1000

                && request.resource.data.updatedBy
                    == request.auth.uid

                && request.resource.data.updatedByEmail
                    == request.auth.token.email;


            // یوازې Superadmin محتوا بدلولی شي
            allow update: if isSuperAdmin()

                && request.resource.data.zikr
                    is string

                && request.resource.data.zikr.size()
                    > 0

                && request.resource.data.zikr.size()
                    <= 1000

                && request.resource.data.comfort
                    is string

                && request.resource.data.comfort.size()
                    > 0

                && request.resource.data.comfort.size()
                    <= 1000

                && request.resource.data.poem
                    is string

                && request.resource.data.poem.size()
                    > 0

                && request.resource.data.poem.size()
                    <= 1000

                && request.resource.data.updatedBy
                    == request.auth.uid

                && request.resource.data.updatedByEmail
                    == request.auth.token.email;


            // ورځنی محتوا نه حذف کېږي
            allow delete: if false;

        }


        // =========================================================
        // DEFAULT DENY
        // =========================================================

        match /{document=**} {

            allow read, write: if false;

        }

    }

}