rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        // =========================================================
        // د افغانستان اسلامي امارت د کره کمیسیون
        // د فورمو د ثبت او مدیریت ډیټابیس
        //
        // Roles:
        // superadmin = بشپړ صلاحیت
        // admin      = ثبت، بدلون او اړوند مدیریت
        // user       = Read / Search
        // =========================================================


        // =========================================================
        // Authentication Helpers
        // =========================================================

        function signedIn() {
            return request.auth != null;
        }


        function adminPath(uid) {
            return /databases/$(database)/documents/admins/$(uid);
        }


        function adminExists(uid) {
            return exists(adminPath(uid));
        }


        function adminData(uid) {
            return get(adminPath(uid)).data;
        }


        // =========================================================
        // Current User Profile
        // =========================================================

        function hasValidAdminProfile() {

            return signedIn()

                && adminExists(request.auth.uid)

                && adminData(request.auth.uid).uid
                    == request.auth.uid

                && adminData(request.auth.uid).active
                    == true

                && (
                    adminData(request.auth.uid).role
                        == "superadmin"

                    ||

                    adminData(request.auth.uid).role
                        == "admin"

                    ||

                    adminData(request.auth.uid).role
                        == "user"
                );
        }


        function isSuperAdmin() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "superadmin";
        }


        function isAdmin() {

            return hasValidAdminProfile()

                && (
                    adminData(
                        request.auth.uid
                    ).role
                        == "superadmin"

                    ||

                    adminData(
                        request.auth.uid
                    ).role
                        == "admin"
                );
        }


        function isUser() {

            return hasValidAdminProfile()

                && adminData(
                    request.auth.uid
                ).role
                    == "user";
        }


        function isMember() {

            return hasValidAdminProfile();
        }


        // =========================================================
        // ADMINS
        // =========================================================

        match /admins/{uid} {

            allow get: if signedIn()
                && (
                    request.auth.uid == uid
                    ||
                    isSuperAdmin()
                );


            allow list: if isSuperAdmin();


            allow create: if isSuperAdmin();


            allow update: if isSuperAdmin();


            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // RECORDS
        // =========================================================

        match /records/{recordId} {

            allow read: if isMember();


            allow create: if isAdmin();


            allow update: if isAdmin();


            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // SETTINGS
        // =========================================================

        match /settings/{settingId} {

            allow read: if isMember();


            allow create: if isAdmin();


            allow update: if isAdmin();


            allow delete: if isSuperAdmin();

        }


        // =========================================================
        // PRESENCE
        // =========================================================

        match /presence/{uid} {

            allow read: if isMember();


            allow create: if isMember()
                && request.auth.uid == uid;


            allow update: if isMember()
                && request.auth.uid == uid;


            allow delete: if isMember()
                && request.auth.uid == uid;

        }


        // =========================================================
        // AUDIT
        // =========================================================

        match /audit/{auditId} {

            allow create: if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email;


            allow read: if isSuperAdmin();


            allow update: if false;


            allow delete: if false;

        }


        // =========================================================
        // DASHBOARD COMMENTS
        // =========================================================

        match /dashboard_comments/{commentId} {

            allow read: if isMember();


            allow create: if isMember()

                && request.resource.data.uid
                    == request.auth.uid

                && request.resource.data.email
                    == request.auth.token.email

                && request.resource.data.text
                    is string

                && request.resource.data.text.size()
                    > 0

                && request.resource.data.text.size()
                    <= 500

                && request.resource.data.displayName
                    is string

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            allow update: if isMember()

                && request.resource.data.uid
                    == resource.data.uid

                && request.resource.data.email
                    == resource.data.email

                && request.resource.data.displayName
                    == resource.data.displayName

                && request.resource.data.text
                    == resource.data.text

                && request.resource.data.createdAt
                    == resource.data.createdAt

                && request.resource.data.diff(
                    resource.data
                ).affectedKeys().hasOnly(
                    [
                        "likes",
                        "hearts"
                    ]
                )

                && request.resource.data.likes
                    is list

                && request.resource.data.hearts
                    is list;


            allow delete: if isSuperAdmin()

                || (
                    isMember()

                    && resource.data.uid
                        == request.auth.uid
                );

        }


        // =========================================================
        // DAILY ISLAMIC CONTENT
        // =========================================================
        //
        // Collection:
        // dashboard_daily_content
        //
        // Document:
        // today
        //
        // Fields:
        // zikr
        // comfort
        // poem
        // updatedAt
        // updatedBy
        // updatedByEmail
        //
        // Read:
        // ټول فعال کارکوونکي
        //
        // Create / Update:
        // یوازې Superadmin
        //
        // Delete:
        // هېڅوک نه شي کولی
        // =========================================================

        match /dashboard_daily_content/{contentId} {


            // ټول فعال کارکوونکي
            // ټاکل شوی محتوا لوستلی شي
            allow read: if isMember();


            // یوازې Superadmin نوی محتوا جوړولی شي
            allow create: if isSuperAdmin()

                && request.resource.data.zikr
                    is string

                && request.resource.data.zikr.size()
                    > 0

                && request.resource.data.zikr.size()
                    <= 1000

                && request.resource.data.comfort
                    is string

                && request.resource.data.comfort.size()
                    > 0

                && request.resource.data.comfort.size()
                    <= 1000

                && request.resource.data.poem
                    is string

                && request.resource.data.poem.size()
                    > 0

                && request.resource.data.poem.size()
                    <= 1000

                && request.resource.data.updatedBy
                    == request.auth.uid

                && request.resource.data.updatedByEmail
                    == request.auth.token.email;


            // یوازې Superadmin محتوا بدلولی شي
            allow update: if isSuperAdmin()

                && request.resource.data.zikr
                    is string

                && request.resource.data.zikr.size()
                    > 0

                && request.resource.data.zikr.size()
                    <= 1000

                && request.resource.data.comfort
                    is string

                && request.resource.data.comfort.size()
                    > 0

                && request.resource.data.comfort.size()
                    <= 1000

                && request.resource.data.poem
                    is string

                && request.resource.data.poem.size()
                    > 0

                && request.resource.data.poem.size()
                    <= 1000

                && request.resource.data.updatedBy
                    == request.auth.uid

                && request.resource.data.updatedByEmail
                    == request.auth.token.email;


            // ورځنی محتوا نه حذف کېږي
            allow delete: if false;

        }


        // =========================================================
        // DEFAULT DENY
        // =========================================================

        match /{document=**} {

            allow read, write: if false;

        }

    }

}
